# Copy to keystore.properties (gitignored) and fill in real values.
# Keep the .jks OUTSIDE the repo directory (e.g. ~/keys/whitestone/)
# so it can never be committed or shared with the project folder.
storeFile=/absolute/path/outside/repo/whitestone-upload-key.jks
storePassword=replace-me
keyAlias=upload
keyPassword=replace-me
