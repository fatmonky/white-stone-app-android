<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for API 31+ (dataExtractionRules): stones, reflections,
     and onboarding state are backed up to cloud and transferred between
     devices. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="white_stone_db" />
        <include domain="database" path="white_stone_db-wal" />
        <include domain="database" path="white_stone_db-shm" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="white_stone_db" />
        <include domain="database" path="white_stone_db-wal" />
        <include domain="database" path="white_stone_db-shm" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
